renv::snapshot()
renv::snapshot()
mykbl <- function(data, col_labs = NA) {
if (names(data[1]) == "X1") {
names(data) <- c(data[1,])
data <- data[-1,]
}
kbl(data,
linesep = '',
escape = FALSE,
col.names = col_labs,
booktabs = TRUE,
align = 'c'
) |>
kable_styling(
bootstrap_options = c("hover", "responsive"),
full_width = FALSE,
latex_options = "HOLD_position"
)
}
#| label: tbl-tab2-1
#| tbl-cap: How did 100 people get to work today
mykbl(lsj_chapter_tables[[2]][[1]])
